{
  "name": "flowmap.gl",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "description": "Flow map drawing layer for Deck.gl",
  "main": "index.js",
  "repository": "git@github.com:visgl/flowmap.gl.git",
  "author": "Ilya Boyandin <ilya@boyandin.me>",
  "license": "Apache-2.0",
  "scripts": {
    "start": "pnpm build && pnpm dev",
    "dev": "pnpm dev:example",
    "clean": "shx rm -rf .turbo packages/*/.turbo packages/*/dist examples/*/.turbo examples/*/dist",
    "dev:example": "turbo dev --filter='./examples/react-app' --filter './packages/*'",
    "build:example": "turbo build --filter='./examples/react-app' --filter './packages/*'",
    "build": "turbo run build --filter './packages/*' --concurrency 1",
    "test": "pnpm test:node && pnpm test:browser",
    "test:imports": "pnpm build && node --test test/*.test.mjs",
    "test:node": "pnpm test:imports && vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:examples": "pnpm build && pnpm --dir examples/vite-app build && pnpm --dir examples/svelte-app build && pnpm --dir examples/react-worker-app build && node --test test/examples/*.test.mjs",
    "test:watch": "vitest",
    "build:docs": "pnpm --dir docs install --frozen-lockfile && pnpm --dir docs build",
    "build:site": "pnpm build:example && pnpm build:docs && shx cp -r examples/react-app/dist docs/build/demo",
    "prettier": "prettier . --write",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "bump": "lerna version --no-push --force-publish",
    "publish-release": "pnpm build && lerna publish from-package",
    "publish-prerelease": "pnpm build && lerna publish --dist-tag next from-package",
    "typecheck": "lerna run --stream typecheck"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "bracketSpacing": false,
    "trailingComma": "all"
  },
  "dependencies": {
    "prettier": "^3.8.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@eslint/js": "^10.0.1",
    "@flowmap.gl/data": "workspace:*",
    "@flowmap.gl/layers": "workspace:*",
    "@luma.gl/core": "^9.4.2",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.65.1",
    "shx": "^0.4.0",
    "turbo": "2.9.14",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "volta": {
    "node": "22.23.4"
  }
}
